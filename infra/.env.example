# Versão do Twenty (mantenha igual ao submódulo /twenty e às libs em apps/uniunica)
TAG=v2.58.2

# URL pública do sistema (troque pelo seu domínio em produção, ex.: https://gestao.suaempresa.com.br)
SERVER_URL=http://localhost:3000

# Banco de dados — gere com: openssl rand -hex 32
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=troque_esta_senha
PG_DATABASE_NAME=default

# Segredo de criptografia — gere com: openssl rand -base64 32
ENCRYPTION_KEY=troque_este_segredo

STORAGE_TYPE=local

# Produção (docker-compose.prod.yml): domínio que aponta para o servidor
# DOMINIO=gestao.suaempresa.com.br

# Opcionais (deixe em branco se não usar) — S3 para arquivos, rotação de chave, flags do servidor
FALLBACK_ENCRYPTION_KEY=
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
DISABLE_DB_MIGRATIONS=
DISABLE_CRON_JOBS_REGISTRATION=

# IA do Twenty (chat do quadro e agentes). Uma das duas basta.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
