# Versão do Twenty (mantenha igual ao submódulo /twenty e às libs em apps/uniunica)
TAG=v2.58.2

# URL pública do sistema (troque pelo seu domínio em produção, ex.: https://gestao.suaempresa.com.br)
SERVER_URL=http://localhost:3000

# Banco de dados — gere com: openssl rand -hex 32
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=troque_esta_senha
PG_DATABASE_NAME=default

# Segredo de criptografia — gere com: openssl rand -base64 32
ENCRYPTION_KEY=troque_este_segredo

STORAGE_TYPE=local
